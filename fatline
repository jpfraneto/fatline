cmd_client() { # your client; on first run, prove who you are (you are your FID), then start it
  if [ ! -f "$ROOT/.fatline/identity.json" ] && [ -t 0 ] && [ -t 1 ]; then
    printf 'Connect your Farcaster account first (scan a QR code with your phone)? [Y/n] '
    read -r ok
    case "$ok" in n|N) ;; *) (cmd_connect) || echo "Not connected; starting the client anyway. Later: fatline connect" ;; esac
  fi
  cmd_up "$@"
}

cmd_worker() { need_node; install infra; node "$ROOT/infra/worker.mjs" "$@"; }

cmd_dashboard() { need_node; node "$ROOT/infra/dashboard.mjs" "$@"; }

cmd_up() {
  need_node
  config_exists || cmd_init
  bold "Installing"
  install indexer
  install apps/opinions
  bold "Building the app"
  (cd "$ROOT/apps/opinions" && npm run build --silent)
  bold "Starting"
  cd "$ROOT/indexer" && exec npm start --silent
}

cmd_dev() {
  need_node
  install indexer
  install apps/opinions
  (cd "$ROOT/indexer" && npm start --silent) &
  trap 'kill %1 2>/dev/null' EXIT
  cd "$ROOT/apps/opinions" && npx vite
}

cmd_status() {
  local port; port=$(node -e 'try{console.log(require(process.argv[1]).port||8787)}catch{console.log(8787)}' "$ROOT/fatline.config.json")
  bold "Your nodes"
  # Every node marked as yours in fatline.config.json, wherever it runs (this machine or a rented server).
  node -e '
    const fs = require("fs");
    let c = {}; try { c = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch {}
    const own = Object.entries(c.networks ?? {}).flatMap(([net, n]) => (n.nodes ?? []).filter((x) => x.own).map((x) => ({ net, url: x.url })));
    (async () => {
      let any = false;
      for (const { net, url } of own) {
        const i = await fetch(url + "/v1/info", { signal: AbortSignal.timeout(5000) }).then((r) => r.json()).catch(() => null);
        if (!i) { if (!url.includes("127.0.0.1")) console.log(`  ${net} ${url}: not answering`); continue; }
        any = true;
        const worst = Math.max(...i.shardInfos.filter((x) => x.shardId !== 0).map((x) => Number(x.blockDelay ?? 0)));
        console.log(`  ${net === "farcaster" ? "Snapchain" : "Hypersnap"} ${i.version} at ${url}: ${worst <= 50 ? "in sync" : `catching up, ${worst} blocks behind`}`);
      }
      if (!any) console.log("  no node of yours is answering (fine in light mode; rent one with fatline compute)");
    })();' "$ROOT/fatline.config.json"
  bold "Indexer"
  if curl -fsS -m 3 "http://127.0.0.1:$port/api/networks" > "$STATE/status.json" 2>/dev/null; then
    node -e '
      for (const n of require(process.argv[1])) {
        console.log(`  ${n.label}: ${n.using ? `reading ${n.using.node} (${n.using.own ? "yours" : "public"})` : "no reachable node"}`);
      }' "$STATE/status.json"
    curl -fsS "http://127.0.0.1:$port/api/health"; echo
  else
    echo "  not running on port $port. Start it with fatline up"
  fi
}

cmd_compute() {
  need_node; install infra; install indexer
  # Default: a wallet pays in USDC on Base (x402, no card, no account, no ETH): AgentMetal, one day,
  # a server plus a 700 GB disk, enough for a node. `node <network>` then installs it.
  # Hetzner with your own API token and card (hourly) only when you ask for it: fatline compute hetzner.
  case "${1:-}" in
    hetzner) shift; node "$ROOT/infra/hetzner.mjs" "$@" ;;
    vps) shift; node "$ROOT/infra/vps.mjs" "$@" ;;
    status|down)
      # A machine rented on Hetzner earlier keeps its own status and down.
      if [ -f "$STATE/hetzner.json" ]; then node "$ROOT/infra/hetzner.mjs" "$@"; else node "$ROOT/infra/compute.mjs" "$@"; fi ;;
    *) node "$ROOT/infra/compute.mjs" "$@" ;;
  esac
}

cmd_test() {
  need_node
  bold "Contracts"; (cd "$ROOT/smart-contracts" && forge test)
  bold "Indexer"; install indexer; (cd "$ROOT/indexer" && npm test --silent)
  bold "Infra"; install infra; (cd "$ROOT/infra" && npm test --silent)
}

cmd_fatliners() {
  need_node
  node --experimental-sqlite --no-warnings=ExperimentalWarning "$ROOT/fatliners/bin/pfp.mjs" "$@"
}

cmd_contracts() {
  command -v forge >/dev/null || fail "Foundry is required: curl -L https://foundry.paradigm.xyz | bash && foundryup"
  local sub="${1:-}"; shift || true
  cd "$ROOT/smart-contracts"
  case "$sub" in
    test) forge test ;;
    local)
      if ! cast chain-id --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1; then
        anvil --silent > "$STATE/anvil.log" 2>&1 &
        echo "Starting a local chain (anvil, pid $!)…"
        for _ in $(seq 1 30); do cast chain-id --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1 && break; sleep 1; done
      fi
      # Anvil's first default account: a public test key, never use it with real money.
      local key=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
      LOCAL_DEV=true forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --private-key "$key" --broadcast --silent
      need_node; node "$ROOT/infra/config-tool.mjs" contracts 31337 http://127.0.0.1:8545 ;;
    fork)
      # Everything real (Clanker, Uniswap, USDC on Base) except the money: a local fork of Base.
      local rpc="${BASE_RPC_URL:-https://mainnet.base.org}"  # needs old-block (archive) access; public RPCs are slow and rate limited
      if ! cast chain-id --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1; then
        anvil --fork-url "$rpc" --chain-id 8453 --compute-units-per-second 100 --retries 20 --fork-retry-backoff 2000 --timeout 120000 --silent > "$STATE/anvil.log" 2>&1 &
        echo "Starting a local fork of Base (anvil, pid $!)…"
        for _ in $(seq 1 60); do cast chain-id --rpc-url http://127.0.0.1:8545 >/dev/null 2>&1 && break; sleep 1; done
      fi
      local key=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
      forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --private-key "$key" --broadcast --silent
      need_node; node "$ROOT/infra/config-tool.mjs" contracts 8453 http://127.0.0.1:8545
      # A fresh dev wallet (anvil's well-known keys have EIP-7702 code on Base, which breaks USDC permits).
      [ -f "$STATE/dev.key" ] || { cast wallet new --json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s)[0].private_key))' > "$STATE/dev.key"; chmod 600 "$STATE/dev.key"; }
      local dev; dev=$(cast wallet address --private-key "$(cat "$STATE/dev.key")")
      node "$ROOT/infra/dev-fund.mjs" "${1:-$dev}"
      echo "Dev wallet key (fork only, import it into your browser wallet to try launching): $STATE/dev.key" ;;
    deploy)
      [ -n "${BASE_RPC_URL:-}" ] || fail "Set BASE_RPC_URL (for example https://mainnet.base.org) first."
      echo "Deploying Voices and AppFactory to Base. You will be asked for the key."
      forge script script/Deploy.s.sol --rpc-url "$BASE_RPC_URL" --broadcast --interactives 1
      need_node; node "$ROOT/infra/config-tool.mjs" contracts 8453 "$BASE_RPC_URL" ;;
    split)
      [ $# -eq 2 ] || fail "usage: fatline contracts split <addressA> <addressB>"
      [ -n "${BASE_RPC_URL:-}" ] || fail "Set BASE_RPC_URL first."
      VOICES=false FACTORY=false SPLIT_A="$1" SPLIT_B="$2" forge script script/Deploy.s.sol --rpc-url "$BASE_RPC_URL" --broadcast --interactives 1 ;;
    *) fail "usage: fatline contracts test|local|fork|deploy|split" ;;
  esac
}

command="${1:-help}"; shift || true
case "$command" in
  help|-h|--help) cmd_help ;;
  doctor|init|node|up|client|connect|dashboard|worker|dev|status|compute|test|contracts|identity|follow|feed|fatliners|setup|egg|hatch|hatchery) "cmd_$command" "$@" ;;
  *) echo "Unknown command: $command"; cmd_help; exit 1 ;;
esac
