#!/usr/bin/env bash
# Fatline: one command to check, build and run the whole system.
# Run fatline help for the list of commands.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)" # through a link too
STATE="$ROOT/.fatline"
mkdir -p "$STATE"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

need_node() {
  command -v node >/dev/null || fail "Node.js 22.12+ is required. Install it from https://nodejs.org (or with nvm), then run this again."
  node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)?0:1)' \
    || fail "Node.js $(node -v) is too old. Install 22.12 or newer."
}

install() { # install <dir>: install exact locked dependencies once
  local dir="$ROOT/$1"
  if [ ! -d "$dir/node_modules" ] || [ "$dir/package-lock.json" -nt "$dir/node_modules" ]; then
    (cd "$dir" && npm ci --no-audit --no-fund --loglevel=error)
  fi
}

# Docker for a node on this machine. On Linux, offer to install it with Docker's official script (asked first;
# a tester on a fresh server had to stop and install it by hand). Elsewhere, say how.
ensure_docker() {
  docker info >/dev/null 2>&1 && return 0
  if command -v docker >/dev/null 2>&1; then
    fail "Docker is installed but not running. Start it (Linux: sudo systemctl start docker · macOS: open Docker Desktop), then run this again."
  fi
  [ "$(uname -s)" = Linux ] || fail "A node on this machine needs Docker. macOS: install Docker Desktop (https://docs.docker.com/desktop/), start it, then run this again."
  local sudo=""; [ "$(id -u)" = 0 ] || sudo="sudo"
  echo "A node on this machine needs Docker, and it isn't installed."
  echo "  It can be installed with Docker's official script:  curl -fsSL https://get.docker.com | $sudo sh"
  if [ -t 0 ]; then
    read -r -p "  Install Docker now? [y/N] " ans
    case "$ans" in y|Y|yes) ;; *) fail "Not installed. Run that line yourself, then run this again." ;; esac
  else
    fail "No terminal to ask in (an agent?). Ask the person, run that line, then run this again."
  fi
  curl -fsSL https://get.docker.com | $sudo sh
  $sudo systemctl enable --now docker >/dev/null 2>&1 || true
  docker info >/dev/null 2>&1 && return 0
  if [ -n "$sudo" ] && sudo docker info >/dev/null 2>&1; then
    sudo usermod -aG docker "$USER"
    fail "Docker is installed. Your user was added to the docker group: log out and back in (or run: newgrp docker), then run this again."
  fi
  fail "Docker was installed but doesn't answer yet. Run this again in a minute."
}

