#!/usr/bin/env bash
# Fatline: one command to check, build and run the whole system.
# Run fatline help for the list of commands.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$ROOT/.fatline"
mkdir -p "$STATE"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

need_node() {
  command -v node >/dev/null || fail "Node.js 22.12+ is required. Install it from https://nodejs.org (or with nvm), then run this again."
  node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)?0:1)' \
    || fail "Node.js $(node -v) is too old. Install 22.12 or newer."
}

install() { # install <dir>: install exact locked dependencies once
  local dir="$ROOT/$1"
  if [ ! -d "$dir/node_modules" ] || [ "$dir/package-lock.json" -nt "$dir/node_modules" ]; then
    (cd "$dir" && npm ci --no-audit --no-fund --loglevel=error)
  fi
}

config_exists() { [ -f "$ROOT/fatline.config.json" ]; }

cmd_help() {
  cat <<'EOF'
Fatline — read Farcaster or Hypersnap from your own machine, plus long-form voices onchain.

Setup (in this order on a new machine):
  fatline setup                 Guided: every step below, one at a time; stop anywhere, run again to continue
                                     --plan shows where you are and the command for each step
  fatline doctor                Check this machine and the networks; recommends full, light or rent
  fatline init                  Choose the default network (Farcaster or Hypersnap)
  fatline compute [--quote]     Rent a machine that can hold a node, by the day, in USDC on Base (x402, AgentMetal,
                                     ~11 USDC/day). You approve with your own wallet: phone (QR) or browser.
                                     --pay phone|browser|here · compute renew --days N pays for more days
                                     compute wallet --pay phone: connect your wallet and see its USDC, signs nothing
  fatline compute hetzner       Your own Hetzner account instead (API token, card, hourly; ~$2.60/day a node)
  fatline compute vps root@IP   A server you already have, any provider: checks it can hold a node
  fatline node <network>        Install a read node (farcaster or hypersnap) on that machine, wait until it
                                     answers, and use it. --local installs on this machine instead (16 GB RAM, Docker)
  fatline compute status        The rented machine, its disk and node sync. compute down: how it stops costing
  fatline dashboard             Your servers and nodes on http://localhost:8790, every 15 s (add <host> to watch more)
  fatline up                    Install, build and start the indexer + apps on http://localhost:8787
  fatline client                The same, but first asks you to connect (below) if you haven't

You are your FID (no seed phrase):
  fatline connect               A QR code: scan it with your phone, sign in with Farcaster; your node confirms
                                     the FID. --open opens the link on this device. connect show | connect forget

No FID? Be a worker (as many as you like):
  fatline worker new            A wallet made here (recovery phrase shown once); it pays for a node in USDC (x402)
  fatline worker                Where it stands: wallet, USDC, node, client, coin. worker restore brings one back

Posting (your client's own app key, no gas):
  fatline identity              Type your seed phrase (hidden, never saved); registers an app key for your FID
  fatline identity show         Is the key active?
  fatline identity revoke       Remove the key from the network and from this machine

Everyday:
  fatline status                Node sync and indexer health
  fatline dev                   Indexer + app with live reload (for changing the app)
  fatline follow <fid|@name>    Keep a local archive of only these accounts, from one node (not a node itself).
                                     --network, --node <name|URL>, --following (add who they follow),
                                     --followers (add who follows them), --depth N, --once
  fatline feed [--limit N]      A timeline from the local SQL archive alone: no node, no network, no keys.
                                     --before <cursor>, --fids a,b, --replies, --json, --stats
  fatline test                  Run every test (contracts, indexer, infra)

Your egg (a Fatliner hatches after your node keeps it warm for 3 days):
  fatline egg lay               Sign the egg with your app key; attesters check your node every hour
                                     --node URL (default: the server fatline compute rented), --to 0x…
  fatline egg                   How warm it is: each day's checks, at every attester
  fatline hatch                 Collect the attesters' signatures; the Fatliner is minted to you (no gas)
  fatline hatchery [init]       Run an attester: check eggs, sign the ones that hatch

Fatliners (PFPs from any FID's history, reference-conditioned):
  fatline fatliners prompt --fid 18350          Read our nodes, write traits + prompt + request (no image call)
                                     --generate makes the image (Codex image tool); --input <file> works offline
  fatline fatliners export --fid 18350          A text-free input file for offline prompt compiling

Contracts (Foundry):
  fatline contracts fork        Fork Base locally (real Clanker + USDC, fake money) and deploy there
  fatline contracts local       Plain local chain with mock USDC (apps without coins only)
  fatline contracts deploy      Deploy Voices + AppFactory to Base (asks for the key; set BASE_RPC_URL)
  fatline contracts split <addressA> <addressB>     Deploy a 50/50 PrizeSplit to Base
EOF
}

cmd_doctor() { need_node; install infra; node "$ROOT/infra/doctor.mjs" "$@"; }

cmd_setup() { need_node; install infra; node "$ROOT/infra/setup.mjs" "$@"; }

cmd_init() { need_node; node "$ROOT/infra/config-tool.mjs" init "$@"; }

cmd_node() {
  # Both are Farcaster nodes: snapchain (Farcaster's own) or hypersnap. "farcaster" is the old name for snapchain.
  if [ "${1:-}" = snapchain ]; then set -- farcaster "${@:2}"; fi
  local network="${1:-}"
  # A machine rented with fatline compute: install the node there, wait for it, use it.
  if [ "${2:-}" != "--local" ] && { [ -f "$STATE/hetzner.json" ] || [ -f "$STATE/hetzner-hypersnap.json" ] || [ -f "$STATE/compute.json" ] || [ -f "$STATE/vps.json" ]; }; then
    need_node; exec node "$ROOT/infra/node-remote.mjs" "$@"
  fi
  case "$network" in
    farcaster) URL="https://raw.githubusercontent.com/farcasterxyz/snapchain/refs/heads/main/scripts/snapchain-bootstrap.sh"; DIR="$HOME/snapchain" ;;
    hypersnap) URL="https://raw.githubusercontent.com/farcasterorg/hypersnap/@latest/scripts/hypersnap-bootstrap.sh"; DIR="$HOME/hypersnap" ;;
    *) fail "usage: fatline node snapchain|hypersnap" ;;
  esac
  docker info >/dev/null 2>&1 || fail "Docker must be installed and running. See https://docs.docker.com/engine/install/"
  local other; other=$([ "$network" = farcaster ] && echo hypersnap || echo farcaster)
  if docker ps --format '{{.Ports}}' | grep -q '3381'; then
    fail "Something already uses port 3381 (maybe a $other node). The upstream scripts run one network per machine."
  fi
  # Keep only recent blocks: a read node needs the current state, not years of old blocks.
  # Snapchain's own setting (pruning.block_retention), set in an override file its scripts never touch.
  # Default 1 day. Validators keep every block, so a node that was offline longer still catches up from them. --keep-blocks keeps everything.
  local keep="1day"
  [ "${2:-}" = "--keep-blocks" ] && keep=""
  [ "$network" = hypersnap ] && [ "${2:-}" != "--prune-blocks" ] && keep=""  # Hypersnap exists to keep full history
  mkdir -p "$DIR"
  if [ -n "$keep" ]; then
    if [ -f "$DIR/docker-compose.override.yml" ] && ! grep -q "fatline\|infinicaster" "$DIR/docker-compose.override.yml"; then
      echo "  $DIR/docker-compose.override.yml exists and is yours; not touching it. Add SNAPCHAIN_PRUNING__BLOCK_RETENTION yourself if you want pruning."
    else
      cat > "$DIR/docker-compose.override.yml" <<YAML
# Written by fatline node. Delete this file (or run with --keep-blocks) to keep every block.
services:
  snapchain:
    environment:
      SNAPCHAIN_PRUNING__BLOCK_RETENTION: "$keep"
YAML
      echo "  Old blocks: deleted after ${keep/day/ day} (Snapchain's pruning.block_retention). Your node keeps the full current state."
    fi
  else
    echo "  Old blocks: kept forever (needs the most disk)."
  fi
  bold "Downloading the official $network bootstrap script"
  curl -fsSL "$URL" -o "$STATE/$network-bootstrap.sh"
  echo "  from:   $URL"
  echo "  sha256: $(shasum -a 256 "$STATE/$network-bootstrap.sh" | cut -d' ' -f1)"
  echo "  it installs into $DIR and runs the node with Docker Compose on ports 3381-3383."
  read -r -p "Read it at $STATE/$network-bootstrap.sh. Run it now? [y/N] " ok
  [ "$ok" = "y" ] || [ "$ok" = "Y" ] || { echo "Stopped."; exit 0; }
  bash "$STATE/$network-bootstrap.sh"
  need_node
  node "$ROOT/infra/config-tool.mjs" own-node "$network" "http://127.0.0.1:3381"
  bold "The node is starting. It downloads a snapshot first; this can take hours."
  echo "Watch progress with: fatline status   (healthy when blockDelay is near 0 on every shard)"
}

cmd_egg() {
  need_node
  install indexer
  cd "$ROOT/indexer" && node --experimental-sqlite --no-warnings=ExperimentalWarning src/egg-cli.mjs "$@"
}

cmd_hatch() { cmd_egg hatch "$@"; }

cmd_hatchery() {
  need_node
  install indexer
  cd "$ROOT/indexer" && exec node --experimental-sqlite --no-warnings=ExperimentalWarning src/hatchery-run.mjs "$@"
}

cmd_follow() {
